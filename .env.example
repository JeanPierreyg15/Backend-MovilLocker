# Copia este archivo como .env antes de ejecutar el proyecto.
# La aplicación NO arranca si SECRET_KEY está vacía o tiene menos de 32 caracteres.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# true: aplica `alembic upgrade head` al arrancar (actualiza BD antiguas sin perder datos).
AUTO_MIGRATE=true

# Solo para desarrollo: con DEBUG=true, /auth/recuperar devuelve el código
# (campo codigo_desarrollo) únicamente si la petición llega desde loopback
# (127.0.0.1/::1). En producción debe ser false.
DEBUG=false

# Correo para la recuperación de contraseña (SMTP).
# Ejemplo con Gmail: smtp.gmail.com + contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false

# URL pública de la app. Solo si es http/https con un host no local se incluye
# un enlace en el correo (con correo y código); si es localhost, se envía solo
# el código.
APP_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost,http://localhost
DATABASE_URL=sqlite:///./locker.db

# IPs/CIDR de proxies de confianza (separadas por coma). Solo si la petición
# llega desde una de ellas se usa X-Forwarded-For para obtener la IP real.
# Ejemplo: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
